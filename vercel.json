{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "2027-retraite.lamaisonveda.com"
        }
      ],
      "destination": "https://srilanka.lamaisonveda.com/fr/retraites/sri-lanka-2027",
      "permanent": false
    },
    {
      "source": "/:chemin*",
      "has": [
        {
          "type": "host",
          "value": "2027-retraite.lamaisonveda.com"
        }
      ],
      "destination": "https://srilanka.lamaisonveda.com/:chemin*",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "maison-veda-retreat.vercel.app"
        }
      ],
      "destination": "https://srilanka.lamaisonveda.com/fr",
      "permanent": true
    },
    {
      "source": "/:chemin*",
      "has": [
        {
          "type": "host",
          "value": "maison-veda-retreat.vercel.app"
        }
      ],
      "destination": "https://srilanka.lamaisonveda.com/:chemin*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/fr",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/fr",
      "permanent": true
    },
    {
      "source": "/(.*)/index.html",
      "destination": "/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "2027-retraite\\.lamaisonveda\\.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(srilanka|images|new_image|visites|icon-logo-final|docs)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
