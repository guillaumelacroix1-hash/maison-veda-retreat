{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "2027-retraite.lamaisonveda.com"
        }
      ],
      "destination": "https://srilanka.lamaisonveda.com/fr/retraites/sri-lanka-2027",
      "permanent": false
    },
    {
      "source": "/:chemin*",
      "has": [
        {
          "type": "host",
          "value": "2027-retraite.lamaisonveda.com"
        }
      ],
      "destination": "https://srilanka.lamaisonveda.com/:chemin*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "2027-retraite\\.lamaisonveda\\.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
